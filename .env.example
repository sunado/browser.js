# Copy to .env and adjust.
#
# scripts/compose.sh derives FRONTEND_DOMAIN, WISP_DOMAIN and WISP_URL from
# MAIN_DOMAIN and the subdomain prefixes below.

# Base domain shared by all services.
MAIN_DOMAIN=example.com

# Resulting public hostnames:
#   app.example.com
#   wisp.example.com
FRONTEND_SUBDOMAIN=app
WISP_SUBDOMAIN=wisp

# Optional full hostname overrides. Leave empty to derive from MAIN_DOMAIN.
FRONTEND_DOMAIN=
WISP_DOMAIN=

# Public WISP WebSocket URL baked into the frontend at build time.
# Leave empty to derive wss://<WISP_DOMAIN>/ with scripts/compose.sh.
# For local HTTP testing use e.g. ws://localhost:8081/.
WISP_URL=

# Origin hosting controller.html, or "none" to disable isolation.
ISOLATION_ORIGIN=none

# Host bind addresses and published ports.
# 127.0.0.1 is correct when the reverse proxy runs on the same host.
# Use 0.0.0.0 when the proxy runs on another host/container.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=10001
WISP_BIND=127.0.0.1
WISP_PORT=10002

# Ports used inside the containers.
FRONTEND_INTERNAL_PORT=80
WISP_INTERNAL_PORT=5001

# WISP server settings.
WISP_LOG_LEVEL=INFO
WISP_ALLOW_PRIVATE_IPS=false
WISP_ALLOW_LOOPBACK_IPS=false
WISP_ALLOW_UDP_STREAMS=true
WISP_ALLOW_TCP_STREAMS=true
WISP_STREAM_LIMIT_TOTAL=-1
WISP_STREAM_LIMIT_PER_HOST=-1

# Build/tool versions.
NODE_VERSION=24
WASM_BINDGEN_VERSION=0.2.105
BINARYEN_VERSION=123
WISP_JS_VERSION=0.4.1
